<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewRegisterLecturer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Faculty Badge Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipFacultyRole"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/role_lecturer"
            android:clickable="false"
            app:chipIcon="@drawable/ic_badge_outline_20"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvLecturerRegisterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_register_lecturer"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/chipFacultyRole"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLecturerRegisterSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/desc_register_lecturer_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tvLecturerRegisterTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Offline Draft / Local Pending Verification Alert Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLecturerDraftBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvLecturerRegisterSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvLecturerOfflineBannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/status_lecturer_draft"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:drawableStart="@android:drawable/stat_sys_warning"
                android:drawablePadding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Full Name (with Title) - Modern Compact Person Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLecturerName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/label_lecturer_name"
            app:startIconDrawable="@drawable/ic_person_outline_20"
            app:startIconContentDescription="@string/label_lecturer_name"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/cardLecturerDraftBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLecturerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textPersonName|textCapWords"
                android:contentDescription="@string/label_lecturer_name" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Staff ID / Employee Number - Modern Compact ID Badge Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffId"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_staff_id"
            app:startIconDrawable="@drawable/ic_badge_outline_20"
            app:startIconContentDescription="@string/label_staff_id"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilLecturerName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textCapCharacters"
                android:contentDescription="@string/label_staff_id" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. University Staff Email Address - Modern Compact Mail Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_staff_email"
            app:startIconDrawable="@drawable/ic_mail_outline_20"
            app:startIconContentDescription="@string/label_staff_email"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilStaffId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textEmailAddress"
                android:contentDescription="@string/label_staff_email" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4a. School Dropdown (pick the school first, then its departments appear below) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSchool"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_school"
            app:startIconDrawable="@drawable/ic_domain_outline_20"
            app:startIconContentDescription="@string/label_school"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilStaffEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <AutoCompleteTextView
                android:id="@+id/actvSchool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="none"
                android:contentDescription="@string/label_school" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. Faculty / Department Dropdown - Modern Compact School/Domain Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDepartment"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_department"
            app:startIconDrawable="@drawable/ic_domain_outline_20"
            app:startIconContentDescription="@string/label_department"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilSchool"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <AutoCompleteTextView
                android:id="@+id/actvDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="none"
                android:contentDescription="@string/label_department" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 5. Password - Modern Compact Lock Icon + Toggle -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLecturerPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_lec_password"
            app:startIconDrawable="@drawable/ic_lock_outline_20"
            app:startIconContentDescription="@string/label_lec_password"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilDepartment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLecturerPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textPassword"
                android:contentDescription="@string/label_lec_password" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 6. Faculty Authorization Token - Modern Compact Key Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFacultyToken"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_faculty_auth_token"
            app:startIconDrawable="@drawable/ic_key_outline_20"
            app:startIconContentDescription="@string/label_faculty_auth_token"
            app:errorEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilLecturerPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFacultyToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textCapCharacters"
                android:contentDescription="@string/label_faculty_auth_token" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primary Register Lecturer Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterLecturer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/btn_register_lecturer"
            app:layout_constraintTop_toBottomOf="@id/tilFacultyToken"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Switch Role to Student Registration -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchToStudentReg"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/switch_to_student_reg"
            app:icon="@drawable/ic_person_outline_20"
            app:layout_constraintTop_toBottomOf="@id/btnRegisterLecturer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Link to Sign In -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToSignInLecturer"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/link_lec_to_login"
            app:layout_constraintTop_toBottomOf="@id/btnSwitchToStudentReg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
