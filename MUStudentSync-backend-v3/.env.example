# Copy to .env and fill in. NEVER commit .env or submit it (lab rule: exclude secrets).
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=studentsync_app
DB_PASSWORD=change_me
DB_NAME=studentsync
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h
# Production behind an HTTPS reverse proxy (Render, Railway, nginx, ...):
TRUST_PROXY=false
REQUIRE_HTTPS=false
# Seed script: the lecturer signs in with this email. Leave the password blank to generate one
LECTURER_EMAIL=lecturer01@mu.example
LECTURER_PASSWORD=
# Challenge 1 test only: allows the script to wipe student data. Use a TEST database!
ALLOW_TEST_RESET=false

# ---- HOSTED deployment only (leave these out on your own computer) ----
# DB_SSL=true                  # hosted databases (Aiven...) require an encrypted connection
# DB_SSL_CA=                   # paste the provider's CA certificate (ca.pem), or use DB_SSL_CA_FILE=/path/ca.pem
# DB_CREATE_DATABASE=false     # the hosted database already exists; set DB_NAME to its name (Aiven: defaultdb)
# TRUST_PROXY=true             # the host's proxy terminates HTTPS; also keeps rate-limiting per real user
# REQUIRE_HTTPS=true           # refuse plain http (the lab requires HTTPS for the remote backend)
